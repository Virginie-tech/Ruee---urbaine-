DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Ruée Urbaine – jeu de course infinie gratuit</title>
<meta name="description" content="Ruée Urbaine : un jeu de course infinie gratuit. Esquive, saute, glisse et ramasse des pièces dans une ville au crépuscule.">
<!-- ADSENSE : collez ici le script fourni par Google (une fois votre site approuvé)
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
-->
<style>
:root{--nuit:#1b1233;--route:#2f3347;--ambre:#ffd23f;--menthe:#2ec4b6;--corail:#ff595e}
*{box-sizing:border-box}
body{margin:0;background:var(--nuit);color:#fff;font-family:"Trebuchet MS",system-ui,sans-serif}
#app{display:flex;flex-direction:column;height:100vh;height:100svh;max-width:520px;margin:auto}
#stage{position:relative;flex:1;min-height:0}
#c{position:absolute;inset:0;width:100%;height:100%;touch-action:none;display:block}
#ov{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;background:rgba(27,18,51,.82)}
#ov h1{font-size:2.3rem;margin:0 0 8px;letter-spacing:.5px}
#ov p{margin:6px 0;max-width:30ch;line-height:1.45;color:#e6defa}
#go{margin-top:18px;padding:14px 38px;font:inherit;font-size:1.2rem;font-weight:700;border:0;border-radius:40px;background:var(--ambre);color:#2a1b00;cursor:pointer}
#go:focus-visible,#pz:focus-visible{outline:3px solid #fff;outline-offset:3px}
#pz{position:absolute;top:10px;right:10px;width:44px;height:44px;border-radius:50%;border:0;background:rgba(0,0,0,.35);color:#fff;font-size:1rem;display:none}
.playing #pz{display:block}
.playing #ov{display:none}
.ad{min-height:0;text-align:center}
.playing .ad{display:none}
#info{max-width:620px;margin:0 auto;padding:28px 20px 60px;line-height:1.6;color:#dcd3f2}
#info h2{margin:24px 0 6px;font-size:1.2rem;color:#fff}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style>
</head>
<body>
<div id="app">
  <div id="stage">
    <canvas id="c" aria-label="Zone de jeu"></canvas>
    <button id="pz" aria-label="Pause">❚❚</button>
    <div id="ov"><h1></h1><div id="tx"></div><button id="go">Jouer</button></div>
  </div>
  <!-- PUB : visible uniquement sur le menu, la pause et l'écran de fin (jamais pendant la course) -->
  <div class="ad" id="ad1">
    <!-- Collez ici le bloc d'annonce AdSense (ins class="adsbygoogle") -->
  </div>
</div>

<section id="info">
  <h2>Comment jouer à Ruée Urbaine</h2>
  <p>Glisse le doigt vers la gauche ou la droite pour changer de voie, vers le haut pour sauter par-dessus les caisses, vers le bas pour glisser sous les barrières. Sur ordinateur, utilise les flèches ou les touches Z, Q, S, D.</p>
  <h2>Un jeu plus juste</h2>
  <p>Tu as deux vies et un court moment d'invincibilité après chaque choc. Chaque rangée d'obstacles laisse toujours un passage, les obstacles sont signalés avant d'arriver, les commandes sont mémorisées une fraction de seconde et le jeu reprend avec un compte à rebours après une pause. Aucune publicité n'apparaît pendant la course.</p>
</section>

<script>
(()=>{
const $=id=>document.getElementById(id),cv=$('c'),g=cv.getContext('2d'),ov=$('ov');
const ls=(k,v)=>{try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){}};
let W,H,Dp,hz,gy,LW;
function rs(){const r=cv.parentElement.getBoundingClientRect();Dp=Math.min(devicePixelRatio||1,2);cv.width=W=r.width*Dp;cv.height=H=r.height*Dp;hz=H*.3;gy=H*.88;LW=Math.min(W*.3,H*.22)}
addEventListener('resize',rs);rs();
const T=d=>1/(1+d/16),Y=t=>hz+(gy-hz)*t,X=(l,t)=>W/2+l*LW*t;
let st='menu',P,O,v,dist,coins,lives,inv,cd,sp,shake=0,time=0,lastReg,buf={j:-9,s:-9};
let best=+(ls('rb')||0),total=+(ls('rt')||0);
function reset(){P={x:0,tl:0,jy:0,vy:0,sl:0};O=[];v=12;dist=0;coins=0;lives=2;inv=0;cd=3;sp=0;lastReg=0;buf={j:-9,s:-9}}
reset();
function show(title,html,btn){ov.querySelector('h1').textContent=title;$('tx').innerHTML=html;$('go').textContent=btn;document.body.classList.remove('playing')}
function menu(){st='menu';show('Ruée Urbaine','<p>Glisse ◄ ► pour changer de voie, ▲ pour sauter, ▼ pour glisser.</p><p>Tu as 2 vies : un choc ne t\'arrête pas tout de suite.</p>'+(best?'<p>Record : '+best+' m</p>':''),'Jouer')}
function start(){reset();st='play';document.body.classList.add('playing')}
function over(){st='over';const d=dist|0;if(d>best){best=d;ls('rb',best)}total+=coins;ls('rt',total);
 show('Course terminée','<p>Distance : <b>'+d+' m</b></p><p>Pièces : <b>'+coins+'</b> (total '+total+')</p><p>Record : '+best+' m</p>','Rejouer')}
function pause(){if(st==='play'){st='pause';show('Pause','<p>Ta course est en attente.</p>','Reprendre')}}
$('go').onclick=()=>{if(st==='pause'){st='play';cd=3;document.body.classList.add('playing')}else start()};
$('pz').onclick=pause;
document.addEventListener('visibilitychange',()=>{if(document.hidden)pause()});
function act(a){if(st!=='play'||cd>0)return;
 if(a==='L')P.tl=Math.max(-1,P.tl-1);else if(a==='R')P.tl=Math.min(1,P.tl+1);
 else if(a==='U')buf.j=time;else if(a==='D'){buf.s=time;if(P.jy>0)P.vy=-9}}
addEventListener('keydown',e=>{const m={ArrowLeft:'L',q:'L',a:'L',ArrowRight:'R',d:'R',ArrowUp:'U',z:'U',w:'U',' ':'U',ArrowDown:'D',s:'D'}[e.key];
 if(m){e.preventDefault();act(m)}else if(e.key==='p')pause();else if(e.key==='Enter'&&st!=='play')$('go').click()});
let px=null,py;
cv.addEventListener('pointerdown',e=>{px=e.clientX;py=e.clientY});
cv.addEventListener('pointermove',e=>{if(px===null)return;const dx=e.clientX-px,dy=e.clientY-py;
 if(Math.max(Math.abs(dx),Math.abs(dy))>22){Math.abs(dx)>Math.abs(dy)?act(dx>0?'R':'L'):act(dy>0?'D':'U');px=e.clientX;py=e.clientY}});
['pointerup','pointercancel','pointerleave'].forEach(n=>cv.addEventListener(n,()=>px=null));

function spawn(){const d0=130,safe=(Math.random()*3|0)-1;
 for(let l=-1;l<=1;l++){if(l===safe||Math.random()>.7)continue;const r=Math.random();O.push({k:r<.4?'w':r<.7?'l':'h',l,d:d0})}
 if(Math.random()<.4)O.push({k:Math.random()<.5?'l':'h',l:safe,d:d0});
 else for(let i=0;i<5;i++)O.push({k:'c',l:safe,d:d0+4+i*3})}

function update(dt){
 shake=Math.max(0,shake-dt);
 if(st==='menu'||st==='over'){dist+=6*dt;return}
 if(st!=='play')return;
 if(cd>0){cd-=dt;return}
 v=Math.min(25,12+dist*.008);dist+=v*dt;
 P.x+=(P.tl-P.x)*Math.min(1,dt*16);
 if(P.jy<=0&&time-buf.j<.15){P.vy=3.5;P.jy=.001;buf.j=-9;P.sl=0}
 if(P.jy>0){P.vy-=11*dt;P.jy+=P.vy*dt;if(P.jy<=0){P.jy=0;P.vy=0}}
 if(P.jy<=0&&P.sl<=0&&time-buf.s<.15){P.sl=.7;buf.s=-9}
 P.sl=Math.max(0,P.sl-dt);inv=Math.max(0,inv-dt);
 sp-=v*dt;if(sp<=0){spawn();sp=Math.max(17,30-v*.5)+Math.random()*4}
 for(const o of O)o.d-=v*dt;
 for(const o of O){if(o.dead||Math.abs(o.d)>.9||Math.abs(P.x-o.l)>.55)continue;
  if(o.k==='c'){o.dead=1;coins++;continue}
  const hit=o.k==='w'||(o.k==='l'&&P.jy<.32)||(o.k==='h'&&P.sl<=0);
  if(hit&&inv<=0){o.dead=1;lives--;inv=1.6;shake=.3;if(lives<=0)return over()}}
 O=O.filter(o=>!o.dead&&o.d>-5);
 const rg=Math.floor(dist/700);if(rg>lastReg){lastReg=rg;lives=Math.min(3,lives+1)}}

function obj(o){const t=T(o.d),x=X(o.l,t),y=Y(t),u=LW*t;
 if(o.k==='c'){g.fillStyle='#ffd23f';g.strokeStyle='#b98a00';g.lineWidth=Math.max(1,u*.03);g.beginPath();g.arc(x,y-.4*u,.13*u,0,7);g.fill();g.stroke();return}
 let h;
 if(o.k==='l'){h=.36;g.fillStyle='#c9853a';g.fillRect(x-.35*u,y-h*u,.7*u,h*u);g.strokeStyle='#7a4c18';g.lineWidth=Math.max(1,u*.04);g.strokeRect(x-.35*u,y-h*u,.7*u,h*u);g.beginPath();g.moveTo(x-.35*u,y-h*u);g.lineTo(x+.35*u,y);g.stroke()}
 else if(o.k==='h'){h=.95;g.fillStyle='#8d93a8';g.fillRect(x-.42*u,y-h*u,.07*u,h*u);g.fillRect(x+.35*u,y-h*u,.07*u,h*u);
  for(let i=0;i<6;i++){g.fillStyle=i%2?'#1f2233':'#ffd23f';g.fillRect(x-.45*u+i*.15*u,y-h*u,.15*u,.3*u)}}
 else{h=1.5;g.fillStyle='#d94f5c';g.fillRect(x-.42*u,y-h*u,.84*u,h*u);g.fillStyle='#ffe3e5';for(let i=0;i<3;i++)g.fillRect(x-.42*u,y-(.35+i*.45)*u,.84*u,.12*u)}
 if(o.d<55){g.fillStyle='#ffd23f';g.font='bold '+Math.max(8,.28*u)+'px sans-serif';g.textAlign='center';g.fillText(o.k==='l'?'▲':o.k==='h'?'▼':'◄ ►',x,y-(h+.15)*u)}}

function player(){const x=X(P.x,1),y=gy-P.jy*LW,s=LW,ph=dist*1.3,sw=Math.sin(ph)*.1*s;
 g.fillStyle='rgba(0,0,0,.35)';g.beginPath();g.ellipse(x,gy,.25*s/(1+P.jy),.05*s,0,0,7);g.fill();
 if(inv>0&&Math.floor(time*12)%2)return;
 if(P.sl>0){g.fillStyle='#3a3f8f';g.fillRect(x-.05*s,y-.18*s,.3*s,.12*s);g.fillStyle='#2ec4b6';g.fillRect(x-.3*s,y-.26*s,.3*s,.2*s);
  g.fillStyle='#c68642';g.beginPath();g.arc(x-.36*s,y-.18*s,.1*s,0,7);g.fill();g.fillStyle='#ff595e';g.fillRect(x-.46*s,y-.3*s,.18*s,.06*s);return}
 g.strokeStyle='#3a3f8f';g.lineWidth=.1*s;g.lineCap='round';
 g.beginPath();g.moveTo(x-.05*s,y-.3*s);g.lineTo(x-.05*s+sw,y-.02*s);g.moveTo(x+.05*s,y-.3*s);g.lineTo(x+.05*s-sw,y-.02*s);g.stroke();
 g.fillStyle='#2ec4b6';g.fillRect(x-.14*s,y-.62*s,.28*s,.34*s);
 g.fillStyle='#c68642';g.beginPath();g.arc(x,y-.74*s,.11*s,0,7);g.fill();
 g.fillStyle='#ff595e';g.fillRect(x-.12*s,y-.87*s,.24*s,.07*s);g.fillRect(x,y-.82*s,.17*s,.04*s)}

function draw(){
 g.setTransform(1,0,0,1,shake>0?(Math.random()-.5)*shake*30*Dp:0,0);
 const gr=g.createLinearGradient(0,0,0,hz);gr.addColorStop(0,'#2b1b5e');gr.addColorStop(1,'#ff9a5a');g.fillStyle=gr;g.fillRect(-30,0,W+60,H);
 g.fillStyle='#1d2030';g.fillRect(-30,hz,W+60,H-hz);
 const n0=Math.floor(dist/14);
 for(let n=n0+10;n>=n0-1;n--){const d=n*14-dist,t=T(d);
  for(const sd of[-1,1]){const x=X(sd*2.7,t),w=LW*1.4*t,h=LW*(2+(n*7%5)*.5)*t,y=Y(t);
   g.fillStyle='hsl(255,30%,'+(12+(1-t)*16)+'%)';g.fillRect(x-w/2,y-h,w,h);
   if((n+sd)%2){g.fillStyle='#ffd66b';g.fillRect(x-w*.3,y-h*.7,w*.15,h*.07);g.fillRect(x+w*.1,y-h*.4,w*.15,h*.07)}}}
 const ta=T(140),tb=T(-4);g.fillStyle='#2f3347';g.beginPath();g.moveTo(X(-1.6,ta),Y(ta));g.lineTo(X(1.6,ta),Y(ta));g.lineTo(X(1.6,tb),Y(tb));g.lineTo(X(-1.6,tb),Y(tb));g.fill();
 g.fillStyle='#e8e3f7';
 for(let n=Math.floor(dist/8);n<Math.floor(dist/8)+18;n++){const d=n*8-dist;if(n%2)continue;const t1=T(Math.max(d,-3)),t2=T(d+4);
  for(const b of[-.5,.5]){const w=LW*.03;g.beginPath();g.moveTo(X(b,t2)-w*t2,Y(t2));g.lineTo(X(b,t2)+w*t2,Y(t2));g.lineTo(X(b,t1)+w*t1,Y(t1));g.lineTo(X(b,t1)-w*t1,Y(t1));g.fill()}}
 O.sort((a,b)=>b.d-a.d);
 for(const o of O)if(o.d>=0)obj(o);
 player();
 for(const o of O)if(o.d<0)obj(o);
 g.setTransform(1,0,0,1,0,0);
 const f=H*.04;g.font='bold '+f+'px sans-serif';g.textAlign='left';g.fillStyle='#fff';g.fillText((dist|0)+' m',W*.04,f*1.6);
 g.fillStyle='#ffd23f';g.fillText('● '+coins,W*.04,f*2.9);
 g.textAlign='center';g.fillStyle='#ff595e';g.fillText('♥'.repeat(Math.max(0,lives)),W/2,f*1.6);
 if(st==='play'&&cd>0){g.fillStyle='#fff';g.font='bold '+H*.14+'px sans-serif';g.fillText(Math.ceil(cd),W/2,H*.5)}}

let last=0;
function loop(ts){const dt=Math.min(.05,(ts-last)/1000||0);last=ts;time+=dt;update(dt);draw();requestAnimationFrame(loop)}
menu();requestAnimationFrame(loop);
})();
</script>
</body>
</html>
